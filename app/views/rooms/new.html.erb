<h1>施設を新規登録</h1>

<%= form_with model: @room do |f| %>
  <div>
    <%= f.label :name, "施設名" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :detail, "施設詳細" %><br>
    <%= f.text_area :detail %>
  </div>

  <div>
    <%= f.label :price, "料金（/日）" %><br>
    <%= f.number_field :price %>
  </div>

  <div>
    <%= f.label :address, "住所" %><br>
    <%= f.text_field :address %>
  </div>

  <div>
  <%= f.label :image, "施設画像" %><br>
  <%= f.file_field :image %>
  </div>

  <%= f.submit "登録" %>
<% end %>

<p><%= link_to "戻る", rooms_path %></p>