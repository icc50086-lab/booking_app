<h1><%= @room.name %></h1>

<% if @room.image.attached? %>
  <%= image_tag @room.image, width: 300 %>
<% else %>
  <%= image_tag "default_room.png", width: 300 %>
<% end %>

<p><%= @room.detail %></p>
<p>料金（/日）：¥<%= @room.price %></p>
<p>住所：<%= @room.address %></p>

<p><%= link_to "戻る", :back %></p>
<p>
  <%= link_to "予約する", new_room_reservation_path(@room) %>
</p>